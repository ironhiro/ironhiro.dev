---
import type { Post } from '../lib/posts';
import { fmtMonthDay, readingMinutes } from '../lib/posts';

interface Props { posts: Post[] }
const { posts } = Astro.props;

const byYear = new Map<number, Post[]>();
for (const p of posts) {
  const y = p.data.pubDate.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
---
{byYear.size === 0 && <p class="empty">아직 글이 없습니다.</p>}
{[...byYear].map(([year, list]) => (
  <section class="year">
    <h2><span>{year}</span><span class="count">{list.length}</span></h2>
    <ol>
      {list.map((post) => (
        <li class="row">
          <time datetime={post.data.pubDate.toISOString()}>{fmtMonthDay(post.data.pubDate)}</time>
          <div class="body">
            <h3>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              {post.data.draft && <span class="draft">draft</span>}
            </h3>
            <p>{post.data.description}</p>
            <div class="foot">
              <span class="meta">{readingMinutes(post.body)} min</span>
              {post.data.tags.length > 0 && (
                <ul class="chips">{post.data.tags.map((t) => <li><a class="chip" href={`/tags/${t}/`}>#{t}</a></li>)}</ul>
              )}
            </div>
          </div>
          <span class="go" aria-hidden="true">→</span>
        </li>
      ))}
    </ol>
  </section>
))}

<style>
  .empty { color: var(--faint); }
  .year { margin-bottom: 56px; }
  .year h2 {
    display: flex; align-items: center; gap: 12px; margin: 0 0 8px;
    font-family: var(--mono); font-size: 13px; font-weight: 500; color: var(--mint);
  }
  .year h2::after { content: ""; flex: 1; height: 1px; background: var(--line); order: 1; }
  .year .count { order: 2; color: var(--faint); }
  ol { list-style: none; margin: 0; padding: 0; }
  .row {
    position: relative; display: grid; grid-template-columns: 56px 1fr 20px; gap: 20px;
    padding: 22px 0; border-bottom: 1px solid var(--line);
  }
  .row:last-child { border-bottom: 0; }
  time { font-family: var(--mono); font-size: 12.5px; color: var(--faint); padding-top: 5px; font-variant-numeric: tabular-nums; }
  h3 { margin: 0 0 6px; font-size: 19px; font-weight: 650; line-height: 1.45; letter-spacing: -.015em; }
  h3 a { color: var(--strong); transition: color .15s; }
  h3 a::after { content: ""; position: absolute; inset: 0; }
  .row:hover h3 a { color: var(--mint); }
  .go { padding-top: 3px; font-family: var(--mono); color: var(--faint); transition: color .15s, transform .15s; }
  .row:hover .go { color: var(--mint); transform: translateX(3px); }
  .draft { margin-left: 8px; padding: 1px 6px; border: 1px dashed var(--faint); border-radius: 4px; font-family: var(--mono); font-size: 11px; font-weight: 500; color: var(--faint); vertical-align: 3px; }
  p { margin: 0; font-size: 15px; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 12px; }
  .chips { position: relative; z-index: 1; }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: 4px; padding: 18px 0; }
    .go { display: none; }
  }
</style>
