---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { PostHeader } from '../../../features/blog/components/PostHeader';
import { Pager } from '../../../features/blog/components/Pager';
import { Toc } from '../../../features/blog/components/Toc';
import { ReadingProgress } from '../../../features/blog/components/ReadingProgress';
import { CodeBlockEnhancer } from '../../../features/blog/components/CodeBlockEnhancer';
import { getPosts, toLink, toSummary, type Post } from '../../lib/posts';
import type { TocHeading } from '../../../types/post';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts are newest first: the next index is the older post
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc: TocHeading[] = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map(({ depth, slug, text }) => ({ depth, slug, text }));
const summary = toSummary(post);
const hasToc = toc.length >= 2;
---
<Base title={summary.title} description={summary.description} wide>
  <ReadingProgress client:load />
  <div class:list={['grid', { 'has-toc': hasToc }]}>
    <article>
      <PostHeader post={summary} />
      <div class="prose">
        <Content />
      </div>
      <Pager older={toLink(older)} newer={toLink(newer)} />
    </article>
    {hasToc && <Toc client:load headings={toc} />}
  </div>
  <CodeBlockEnhancer client:load />
</Base>

<style>
  .grid { max-width: 720px; margin: 0 auto; }
  @media (min-width: 1120px) {
    .grid.has-toc { max-width: none; display: grid; grid-template-columns: minmax(0, 720px) 220px; justify-content: center; gap: 64px; }
  }
</style>
