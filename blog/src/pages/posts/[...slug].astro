---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate, readingMinutes, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts are newest first: the next index is the older post
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { title, description, pubDate, updatedDate, tags } = post.data;
---
<Base title={title} description={description} wide>
  <div class="progress" aria-hidden="true"></div>
  <div class:list={['grid', { 'has-toc': toc.length >= 2 }]}>
    <article>
      <header class="post-head">
        <a class="back" href="/">← posts</a>
        <h1>{title}</h1>
        <p class="meta">
          <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
          {updatedDate && <span>수정 {fmtDate(updatedDate)}</span>}
          <span>{readingMinutes(post.body)}분 읽기</span>
        </p>
        {tags.length > 0 && (
          <ul class="chips">{tags.map((t) => <li><a class="chip" href={`/tags/${t}/`}>#{t}</a></li>)}</ul>
        )}
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label="다른 글">
        {older ? (
          <a class="prev" href={`/posts/${older.id}/`}><span class="label">← prev</span><span class="t">{older.data.title}</span></a>
        ) : <span />}
        {newer && (
          <a class="next" href={`/posts/${newer.id}/`}><span class="label">next →</span><span class="t">{newer.data.title}</span></a>
        )}
      </nav>
    </article>

    {toc.length >= 2 && (
      <aside class="toc" aria-label="목차">
        <p class="toc-title">목차</p>
        <ol>
          {toc.map((h) => (
            <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </aside>
    )}
  </div>
</Base>

<style>
  .progress {
    position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 20;
    background: var(--mint); box-shadow: 0 0 8px var(--mint); transform-origin: 0 50%; transform: scaleX(var(--p, 0));
  }
  .grid { max-width: 720px; margin: 0 auto; }
  .post-head { margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid var(--line); }
  .back { display: inline-block; margin-bottom: 28px; font-family: var(--mono); font-size: 13px; color: var(--faint); transition: color .15s; }
  .back:hover { color: var(--mint); }
  h1 { margin: 0 0 18px; font-size: clamp(28px, 5vw, 42px); line-height: 1.25; letter-spacing: -.035em; font-weight: 750; color: var(--strong); }
  .post-head .meta { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0 0 16px; }
  .post-head .meta span + span::before, .post-head .meta time + span::before { content: "/"; margin-right: 16px; color: var(--line); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 72px; padding-top: 32px; border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); transition: border-color .15s; }
  .pager a:hover { border-color: var(--mint-line); }
  .pager a:hover .t { color: var(--mint); }
  .pager .next { grid-column: 2; text-align: right; }
  .pager .label { font-family: var(--mono); font-size: 12px; color: var(--faint); }
  .pager .t { color: var(--strong); font-weight: 600; line-height: 1.45; transition: color .15s; }

  .toc { display: none; }
  @media (min-width: 1120px) {
    .grid.has-toc { max-width: none; display: grid; grid-template-columns: minmax(0, 720px) 220px; justify-content: center; gap: 64px; }
    .toc { display: block; position: sticky; top: 100px; align-self: start; max-height: calc(100vh - 132px); overflow-y: auto; font-size: 13.5px; }
    .toc-title { margin: 0 0 12px; font-family: var(--mono); font-size: 12px; color: var(--mint); }
    .toc ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
    .toc li a { display: block; padding: 5px 0 5px 14px; margin-left: -1px; border-left: 2px solid transparent; color: var(--faint); line-height: 1.5; transition: color .15s, border-color .15s; }
    .toc li.d3 a { padding-left: 26px; font-size: 13px; }
    .toc li a:hover { color: var(--strong); }
    .toc li a.active { color: var(--mint); border-left-color: var(--mint); }
  }
  @media (max-width: 640px) {
    .pager { grid-template-columns: 1fr; }
    .pager .next { grid-column: 1; }
  }
</style>

<script>
  // reading progress
  const bar = document.querySelector<HTMLElement>('.progress');
  const article = document.querySelector('article');
  const onScroll = () => {
    if (!bar || !article) return;
    const r = article.getBoundingClientRect();
    const total = r.height - innerHeight;
    bar.style.setProperty('--p', String(total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1));
  };

  // table of contents highlight
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const heads = tocLinks.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  const onTocScroll = () => {
    let current = -1;
    heads.forEach((h, i) => { if (h && h.getBoundingClientRect().top <= 120) current = i; });
    tocLinks.forEach((a, i) => a.classList.toggle('active', i === current));
  };

  addEventListener('scroll', () => { onScroll(); onTocScroll(); }, { passive: true });
  addEventListener('resize', onScroll);
  onScroll(); onTocScroll();

  // code blocks: language label + copy button
  document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    const head = document.createElement('div');
    head.className = 'code-head';
    const lang = document.createElement('span');
    lang.className = 'lang';
    lang.textContent = pre.dataset.language && pre.dataset.language !== 'plaintext' ? pre.dataset.language : 'text';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy';
    btn.textContent = '복사';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = '복사됨';
      } catch {
        btn.textContent = '실패';
      }
      setTimeout(() => (btn.textContent = '복사'), 1500);
    });
    head.append(lang, btn);
    pre.replaceWith(wrap);
    wrap.append(head, pre);
  });
</script>
