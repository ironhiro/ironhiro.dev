---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getTags } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getTags(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---
<Base title={`#${tag}`} description={`'${tag}' 태그가 붙은 글 ${posts.length}개`}>
  <p class="kicker"><a href="/tags/">tags</a> / {tag}</p>
  <h1 class="page-title"><span class="hash">#</span>{tag}<span class="n">{posts.length}</span></h1>
  <PostList posts={posts} />
</Base>

<style>
  .hash { color: var(--mint); font-family: var(--mono); font-weight: 500; margin-right: 4px; }
  .n { margin-left: 12px; font-family: var(--mono); font-size: 15px; font-weight: 400; color: var(--faint); }
</style>
