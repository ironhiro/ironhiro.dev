---
import Base from '../../layouts/Base.astro';
import { getPosts, getTags } from '../../lib/posts';

const tags = getTags(await getPosts());
---
<Base title="태그">
  <p class="eyebrow">Tags</p>
  <h1>태그</h1>
  <ul class="list">
    {tags.map(([t, n]) => (
      <li><a href={`/tags/${t}/`}><span>#{t}</span><span class="n">{n}</span></a></li>
    ))}
  </ul>
</Base>

<style>
  h1 { font-size: 32px; color: var(--strong); margin: 0 0 32px; letter-spacing: -.02em; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
  .list a {
    display: flex; justify-content: space-between; padding: 12px 16px; border: 1px solid var(--line); border-radius: 10px;
    color: var(--strong); transition: border-color .15s, background .15s;
  }
  .list a:hover { border-color: var(--accent); background: var(--card-hover); }
  .n { color: var(--faint); font-variant-numeric: tabular-nums; }
</style>
