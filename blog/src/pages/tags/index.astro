---
import Base from '../../layouts/Base.astro';
import { getPosts, getTags } from '../../lib/posts';

const tags = getTags(await getPosts());
---
<Base title="태그">
  <p class="kicker">tags</p>
  <h1 class="page-title">태그</h1>
  <ul class="list">
    {tags.map(([t, n]) => (
      <li><a href={`/tags/${t}/`}><span><span class="hash">#</span>{t}</span><span class="n">{n}</span></a></li>
    ))}
  </ul>
</Base>

<style>
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
  .list a {
    display: flex; justify-content: space-between; align-items: center; padding: 14px 16px;
    border: 1px solid var(--line); border-radius: 10px; background: var(--surface);
    font-family: var(--mono); font-size: 14px; color: var(--strong); transition: border-color .15s, color .15s;
  }
  .list a:hover { border-color: var(--mint-line); color: var(--mint); }
  .hash { color: var(--mint); margin-right: 2px; }
  .n { font-size: 12.5px; color: var(--faint); font-variant-numeric: tabular-nums; }
</style>
