---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다">
  <p class="kicker">error 404</p>
  <h1 class="page-title">페이지를 찾을 수 없습니다</h1>
  <p>주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
  <p><a class="back" href="/">← 글 목록으로</a></p>
</Base>

<style>
  .page-title { margin-bottom: 14px; }
  .back {
    display: inline-flex; margin-top: 12px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 8px;
    background: var(--surface); font-family: var(--mono); font-size: 13px; transition: border-color .15s, color .15s;
  }
  .back:hover { color: var(--mint); border-color: var(--mint-line); }
</style>
