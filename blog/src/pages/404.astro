---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다">
  <p class="eyebrow">404</p>
  <h1>페이지를 찾을 수 없습니다</h1>
  <p>주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
  <p><a class="back" href="/">← 글 목록으로</a></p>
</Base>

<style>
  h1 { font-size: 32px; color: var(--strong); margin: 0 0 12px; letter-spacing: -.02em; }
  .back { color: var(--accent); }
</style>
