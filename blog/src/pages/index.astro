---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, getTags } from '../lib/posts';
import { SITE_DESCRIPTION, RESUME_URL } from '../consts';

const posts = await getPosts();
const tags = getTags(posts);
---
<Base>
  <section class="hero">
    <p class="eyebrow">ironhiro.log</p>
    <h1>소프트웨어와 하드웨어 사이의 기록</h1>
    <p class="desc">{SITE_DESCRIPTION}</p>
    <p class="by"><a href={RESUME_URL}>조용현</a> · 키오스크 풀스택 개발자</p>
  </section>

  {tags.length > 0 && (
    <ul class="chips tags" aria-label="태그">
      {tags.map(([t, n]) => <li><a class="chip" href={`/tags/${t}/`}>{t}<span class="n">{n}</span></a></li>)}
    </ul>
  )}

  <PostList posts={posts} />
</Base>

<style>
  .hero { margin-bottom: 40px; }
  h1 { font-size: clamp(26px, 5vw, 38px); line-height: 1.3; letter-spacing: -.03em; color: var(--strong); margin: 0 0 16px; font-weight: 750; }
  .desc { max-width: 560px; margin: 0 0 12px; }
  .by { font-size: 14.5px; color: var(--faint); margin: 0; }
  .by a { color: var(--strong); border-bottom: 1px solid var(--line); }
  .by a:hover { color: var(--accent); border-color: var(--accent); }
  .tags { margin: 0 0 48px; }
  .n { margin-left: 6px; opacity: .6; font-variant-numeric: tabular-nums; }
</style>
