---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, getTags } from '../lib/posts';
import { SITE_DESCRIPTION, RESUME_URL } from '../consts';

const posts = await getPosts();
const tags = getTags(posts);
---
<Base>
  <section class="hero">
    <p class="kicker">software ⇄ hardware</p>
    <h1>소프트웨어와 하드웨어 사이의 기록</h1>
    <p class="desc">{SITE_DESCRIPTION}</p>
    <p class="by">by <a href={RESUME_URL}>조용현</a> · 키오스크 풀스택 개발자</p>
  </section>

  {tags.length > 0 && (
    <ul class="chips tags" aria-label="태그">
      {tags.map(([t, n]) => <li><a class="chip" href={`/tags/${t}/`}>#{t}<span class="n">{n}</span></a></li>)}
    </ul>
  )}

  <PostList posts={posts} />
</Base>

<style>
  .hero { margin-bottom: 40px; }
  h1 { margin: 0 0 18px; font-size: clamp(30px, 6vw, 46px); line-height: 1.2; letter-spacing: -.04em; font-weight: 750; color: var(--strong); }
  .desc { max-width: 560px; margin: 0 0 14px; font-size: 16.5px; }
  .by { margin: 0; font-family: var(--mono); font-size: 13px; color: var(--faint); }
  .by a { color: var(--strong); border-bottom: 1px solid var(--line); }
  .by a:hover { color: var(--mint); border-color: var(--mint-line); }
  .tags { margin: 0 0 56px; }
  .n { margin-left: 6px; color: var(--faint); font-variant-numeric: tabular-nums; }
</style>
