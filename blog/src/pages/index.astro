---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base>
  <p class="intro">{SITE_DESCRIPTION}</p>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}/`}>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <time class="meta" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .intro { color: var(--muted); margin: 0 0 40px; }
  .posts { list-style: none; margin: 0; padding: 0; }
  .posts li { border-top: 1px solid var(--line); }
  .posts a { display: block; padding: 24px 0; color: inherit; }
  .posts a:hover { text-decoration: none; }
  .posts a:hover h2 { color: var(--accent); }
  .posts h2 { font-size: 21px; margin: 0 0 4px; letter-spacing: -.01em; }
  .posts p { margin: 0 0 6px; color: var(--muted); font-size: 15.5px; }
</style>
