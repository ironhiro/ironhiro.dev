---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, RESUME_URL, GITHUB_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const { title, description = SITE_DESCRIPTION, wide = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isPosts = path === '/' || path.startsWith('/posts');
const isTags = path.startsWith('/tags');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={path.startsWith('/posts/') ? 'article' : 'website'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <header class="site-header">
      <div class:list={['wrap', { wide }]}>
        <a class="brand" href="/"><span class="mark" aria-hidden="true"></span>{SITE_TITLE}</a>
        <nav aria-label="사이트">
          <a href="/" class:list={{ on: isPosts }}>글</a>
          <a href="/tags/" class:list={{ on: isTags }}>태그</a>
          <a href={RESUME_URL}>About</a>
          <a class="icon" href={GITHUB_URL} target="_blank" rel="noopener" aria-label="GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
          <a class="icon" href="/rss.xml" aria-label="RSS">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 019 9"/><path d="M4 4a16 16 0 0116 16"/><circle cx="5" cy="19" r="1.2" fill="currentColor"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main class:list={['wrap', { wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class:list={['wrap', { wide }]}>
        <span>© {new Date().getFullYear()} 조용현</span>
        <span class="links">
          <a href={RESUME_URL}>ironhiro.dev</a>
          <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .wrap.wide { max-width: 1120px; }
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header .wrap { display: flex; justify-content: space-between; align-items: center; height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 750; letter-spacing: -.01em; color: var(--strong); font-size: 17px; }
  .mark { width: 10px; height: 10px; border-radius: 3px; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  nav { display: flex; align-items: center; gap: 4px; font-size: 14.5px; }
  nav a { color: var(--faint); padding: 6px 10px; border-radius: 6px; transition: color .15s, background .15s; }
  nav a:hover { color: var(--strong); background: var(--card-hover); }
  nav a.on { color: var(--strong); }
  nav a.icon { display: inline-flex; padding: 7px; }
  nav svg { width: 18px; height: 18px; }
  main { padding-top: 56px; padding-bottom: 120px; min-height: calc(100vh - 160px); }
  .site-footer { border-top: 1px solid var(--line); padding: 28px 0 40px; font-size: 13.5px; color: var(--faint); }
  .site-footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }
  .site-footer .links { display: flex; gap: 18px; }
  .site-footer a { color: var(--faint); }
  .site-footer a:hover { color: var(--strong); }
  @media (max-width: 640px) {
    nav a { padding: 6px 6px; }
    main { padding-top: 40px; padding-bottom: 96px; }
    nav { gap: 0; font-size: 14px; }
    .brand { font-size: 16px; gap: 8px; }
  }
</style>
