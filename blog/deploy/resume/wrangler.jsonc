// Resume Worker (ironhiro.dev). Cloudflare root directory: blog/deploy/resume
// It lives in its own folder so this project and the blog each have their own wrangler.jsonc.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "ironhiro-resume",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "../../dist/resume" },
  "previews": {},
  "routes": [{ "pattern": "ironhiro.dev", "custom_domain": true }]
}
